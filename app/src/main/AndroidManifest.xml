            android:exported="false"
            android:label="@string/title_activity_start_admin"
            android:theme="@style/Theme.Eclinic" />
        <activity
            android:name=".firebase.FirestoreHelper"
            android:exported="false"
            android:label="@string/title_activity_start"
            android:theme="@style/Theme.Eclinic" />
        <activity
            android:name="com.example.eclinic1.LoginActivity"
            android:exported="true"/>
        <activity
            android:name=".HomeActivity"
            android:exported="true" />
        <activity
            android:name=".AppNavHost"
            android:exported="false" />
        <activity
            android:name="com.example.eclinic1.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>